  {
   "name": "clip_update",
   "kind": "write",
   "idempotent": true,
   "description": "改片段属性(同 patch 重复应用结果一致);册四 T4.6 起 patch.fx 承接片段特效(整对象替换:combo 叠加栈上限 3 顺序即应用顺序 + in/out 槽位;目录 GET /catalogs)",
   "inputSchema": {
    "type": "object",
    "properties": {
     "root": {
      "type": "string",
      "description": "工程目录绝对路径"
     },
     "clipId": {
      "type": "string"
     },
     "patch": {
      "type": "object",
      "properties": {
       "startMs": {
        "type": "integer"
       },
       "durationMs": {
        "type": "integer"
       },
       "sourceInMs": {
        "type": "integer"
       },
       "speed": {
        "type": "number"
       },
       "volume": {
        "type": "number"
       },
       "opacity": {
        "type": "number"
       },
       "scale": {
        "type": "number"
       },
       "text": {
        "type": "string"
       },
       "freezeMs": {
        "type": "integer"
       },
       "speedCurve": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "atMs",
          "speed"
         ],
         "properties": {
          "atMs": {
           "type": "integer",
           "minimum": 0
          },
          "speed": {
           "type": "number",
           "minimum": 0.25,
           "maximum": 4
          }
         }
        },
        "description": "分段速度曲线(册四 A4 T4.4):点集 {atMs,speed},atMs 相对片段起点;有值时优先于 speed;整组替换"
       },
       "reverse": {
        "type": "boolean",
        "description": "倒放开关(册四 A4 T4.4):reverse 先于变速;ffmpeg reverse 整段缓冲,长片段内存风险,长素材先切短再倒"
       },
       "rotation": {
        "type": "number",
        "description": "旋转角度(度;册四 A4 T4.9):任意值,渲染端 mod 360 归一;±90 走 transpose 精确互换宽高,其余角度画布内旋转出界裁切"
       },
       "crop": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "w",
         "h"
        ],
        "properties": {
         "x": {
          "type": "integer",
          "minimum": 0
         },
         "y": {
          "type": "integer",
          "minimum": 0
         },
         "w": {
          "type": "integer",
          "exclusiveMinimum": 0
         },
         "h": {
          "type": "integer",
          "exclusiveMinimum": 0
         }
        },
        "description": "源域裁剪矩形(册四 A4 T4.9):源素材像素坐标;整对象替换"
       },
       "flip": {
        "type": "string",
        "enum": [
         "none",
         "h",
         "v"
        ],
        "description": "翻转(册四 A4 T4.9):h=水平镜像 v=垂直镜像"
       },
       "transition": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "type": {
          "type": "string",
          "enum": [
           "fade",
           "wipeleft",
           "wipeup",
           "slideleft",
           "circleopen",
           "cut",
           "none"
          ]
         },
         "durMs": {
          "type": "number"
         },
         "reason": {
          "type": "string",
          "enum": [
           "jumpcut",
           "topic"
          ]
         },
         "fx": {
          "type": "string"
         }
        },
        "description": "转场子 patch(按字段合并,None 不改);独立工具 transition_set 的同参通道"
       },
       "motion": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "in": {
          "type": "string"
         },
         "inMs": {
          "type": "number"
         },
         "out": {
          "type": "string"
         },
         "outMs": {
          "type": "number"
         }
        },
        "description": "动效子 patch(按字段合并,None 不改);独立工具 motion_set 的同参通道"
       },
       "fx": {
        "type": "object",
        "description": "片段特效(整对象替换):combo=[{fx,params}…] 上限 3 顺序即应用顺序;in/out 槽位登记待渲染(册五);未注册 fxId 渲染端逐项降级 WARN(fxDegraded)",
        "properties": {
         "in": {
          "$ref": "#/$defs/fxEntry"
         },
         "out": {
          "$ref": "#/$defs/fxEntry"
         },
         "combo": {
          "type": "array",
          "maxItems": 3,
          "items": {
           "$ref": "#/$defs/fxEntry"
          }
         }
        },
        "additionalProperties": false
       },
       "textStyle": {
        "type": "object",
        "additionalProperties": false,
        "description": "文本样式(册四 T4.7):整对象替换;字段 fontFamily/fontSize(8-500)/color/outlineColor/outlineWidth(0-20)/borderStyle(1|3)/backColor/shadow(0-20)/align(九宫格)/lineSpacing/opacity(0-1)/x/y(画布像素,锚点=align)/karaoke;渲染按 ADR-0016 生成临时 ASS",
        "properties": {
         "fontFamily": {
          "type": "string"
         },
         "fontSize": {
          "type": "number",
          "minimum": 8,
          "maximum": 500
         },
         "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
         },
         "outlineColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
         },
         "outlineWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
         },
         "borderStyle": {
          "type": "integer",
          "enum": [
           1,
           3
          ]
         },
         "backColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
         },
         "shadow": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
         },
         "align": {
          "type": "string",
          "enum": [
           "topLeft",
           "topCenter",
           "topRight",
           "middleLeft",
           "center",
           "middleRight",
           "bottomLeft",
           "bottomCenter",
           "bottomRight"
          ]
         },
         "lineSpacing": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
         },
         "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
         },
         "x": {
          "type": "number",
          "minimum": 0
         },
         "y": {
          "type": "number",
          "minimum": 0
         },
         "karaoke": {
          "type": "boolean"
         }
        }
       },
       "huazi": {
        "type": "object",
        "additionalProperties": false,
        "description": "花字挂载(册四 T4.7):整对象替换;{template: hz.<id>(目录 GET /catalogs), params? 覆写模板默认};未注册渲染降级纯文本 + WARN",
        "required": [
         "template"
        ],
        "properties": {
         "template": {
          "type": "string"
         },
         "params": {
          "type": "object"
         }
        }
       },
       "denoise": {
        "type": "string",
        "enum": [
         "off",
         "low",
         "mid",
         "high"
        ],
        "description": "降噪档(册四 T4.8):afftdn 参数映射;混音链位置 = aformat 后、倒放/变速前"
       },
       "pitch": {
        "type": "number",
        "minimum": -12,
        "maximum": 12,
        "description": "保速变调半音档(册四 T4.8):asetrate+aresample ×2^(n/12),atempo(speed/k) 补偿保速;链序 = 降噪→倒放→变调→变速"
       }
      },
      "description": "改片段属性(按字段合并;textStyle/huazi/crop/fx 为整对象替换);册四 T4.7/T4.8 起 patch.textStyle/patch.huazi 承接文本样式与花字,patch.denoise/patch.pitch 承接降噪与变调"
     },
     "summary": {
      "type": "string"
     },
     "causedBy": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "expectRev": {
      "type": "integer"
     }
    },
    "required": [
     "root",
     "clipId"
    ]
   },
   "outputSchema": {
    "$ref": "#/definitions/envelope"
   }
  },
