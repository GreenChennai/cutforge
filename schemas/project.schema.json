{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CutForge/CutFlow 项目 IR v2(毫秒级时间线;version 恒为 1 兼容旧读法,schemaVersion 表达契约演进)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "schemaVersion",
    "slug",
    "fps",
    "canvas",
    "tracks"
  ],
  "properties": {
    "version": {
      "const": 1,
      "description": "整数版本恒为 1,兼容 CutFlow 既有工程的读法;schema 自身演进用 schemaVersion 表达(计划书 3.3 第 5 项)"
    },
    "schemaVersion": {
      "type": "string",
      "const": "2.0.0",
      "description": "schema 契约版本(semver);v1 工程由迁移器补齐"
    },
    "slug": {
      "type": "string",
      "description": "工程标识(工程目录名)"
    },
    "fps": {
      "type": "integer",
      "enum": [
        24,
        25,
        30,
        50,
        60
      ],
      "description": "允许集来自 schemas/constants.ratios.json(由 rs_common/platforms 生成,零漂移门禁)"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "description": "ADR-0015(册四 T4.9):宽高从三值枚举扩为范围约束——64 ≤ 值 ≤ 7680 且必须为偶数(渲染链 yuv420p/x264 对奇数尺寸直接报错,约束前移到 schema,超界在 SCHEMA_INVALID 拒绝);schemas/constants.ratios.json 的 canvasAllowed 是预设推荐集(1080/1440/1920),不是合法集",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 7680,
          "multipleOf": 2
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "maximum": 7680,
          "multipleOf": 2
        }
      }
    },
    "backends": {
      "type": "array",
      "items": {
        "enum": [
          "ffmpeg",
          "jianying",
          "cutforge"
        ]
      },
      "minItems": 1,
      "description": "N 后端注册表(ADR-0037):本工程声明启用的 IR 消费者;枚举封闭,扩集先升 schema。v1 工程由迁移器补默认 [\"ffmpeg\"]"
    },
    "notes": {
      "type": "string",
      "default": "notes.json",
      "description": "时间轴标注文件路径(相对工程根);允许内联模式由 notes.schema.json 的 items 数组承接,单文件工程可指向自身小节(计划书 3.3 第 3 项)"
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "clips"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[VAT][0-9]+$",
            "description": "轨道稳定 id,确定性生成规则:<kind 首字母大写><轨道序号+1>,如 V1/A1/T2(计划书 3.3 第 2 项);首次生成后写回,此后不变——标注锚点依赖它"
          },
          "kind": {
            "enum": [
              "video",
              "audio",
              "text"
            ]
          },
          "name": {
            "type": "string",
            "description": "轨道显示名(track_update 重命名;册四 A4 T4.2)"
          },
          "locked": {
            "type": "boolean",
            "default": false,
            "description": "轨道锁定(防误编辑标记;track_update 设置。本册仅承载 IR 字段与命令链,编辑拦截策略候后续册)"
          },
          "mute": {
            "type": "boolean",
            "default": false,
            "description": "轨道静音(渲染混音链消费;track_update 设置,字段与语义链册四 A4 T4.2 就位,渲染联动候 BE3)"
          },
          "solo": {
            "type": "boolean",
            "default": false,
            "description": "轨道独奏(渲染混音链:solo 生效时仅独奏轨出声;track_update 设置,渲染联动候 BE3)"
          },
          "hidden": {
            "type": "boolean",
            "default": false,
            "description": "轨道隐藏(视频轨不参与合成/壳不显示其片段;track_update 设置,渲染联动候 BE3)"
          },
          "heightPx": {
            "type": "integer",
            "minimum": 16,
            "description": "轨道在时间线面板的显示高度(像素;壳消费,纯 UI 偏好,不影响渲染)"
          },
          "color": {
            "type": "string",
            "description": "轨道标识色(壳时间线轨道条着色;建议 #RRGGBB 形态,契约层不锁格式)"
          },
          "clips": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/clip"
            }
          }
        }
      }
    },
    "bgm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "src": {
          "type": "string"
        },
        "assetId": {
          "type": "string",
          "description": "BGM 素材库 manifest.json 的稳定 id(bgm.set --assetId / asset.swap;CutFlow 分册01/ADR-0053)"
        },
        "gainDb": {
          "type": "number",
          "default": -18
        },
        "ducking": {
          "type": "boolean",
          "default": true
        },
        "loop": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "enum": [
          "9x16",
          "3x4",
          "16x9"
        ]
      },
      "description": "要产出的比例;canvas 是主比例,第二个比例走 reframe 重构图"
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ms",
          "label"
        ],
        "properties": {
          "ms": {
            "type": "number"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "subtitle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ass": {
          "type": "string",
          "description": "ASS 文件路径;由 rs_subtitle.py 先生成"
        },
        "source": {
          "type": "string",
          "description": "字幕源文件路径(tts manifest / transcript json);rs_jy_draft 经它回读 wordline 的 sentences/segments 求卡时间(v0.15 起纳入契约,此前实现已读写但 schema 缺失)"
        },
        "style": {
          "type": "string"
        }
      }
    },
    "joinCrossfadeMs": {
      "type": "number",
      "minimum": 0,
      "default": 120,
      "description": "0<joinCrossfadeMs<1帧 的转场提升为该时长的交叉溶解(ADR-0023);0=显式禁用提升(回退硬切)。transition 唯一合法时长字段是 durMs——ms 是幽灵字段,因 additionalProperties:false 而显式报错(计划书 3.3 第 7/8 项)"
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "description": "工程级字体(font.set --scope project 的承载;字体唯一真相源在 artboard fonts/,S7 全链标脏消费)",
      "required": [
        "family"
      ],
      "properties": {
        "family": {
          "type": "string"
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "description": "渲染效果开关(effect.glsl.enable 的承载,CutFlow 分册04 §4.2):glsl=false 时 T2 GLSL 效果全部降级为最接近的 T1 近似并留痕(ADR-0054 三级分级)",
      "properties": {
        "glsl": {
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "$defs": {
    "fxEntry": {
      "type": "object",
      "additionalProperties": false,
      "description": "单条特效声明(fx.apply / clip.fx.slot 的承载,CutFlow 分册04 §4.2):fxId + 透传参数",
      "required": [
        "fx"
      ],
      "properties": {
        "fx": {
          "type": "string",
          "description": "fxId(效果目录 / 渲染端注册表;CutFlow M13 起全量消费)"
        },
        "params": {
          "type": "object",
          "description": "特效参数(透传注册表;未声明的键由注册表按默认值裁决)"
        }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "startMs",
        "durationMs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[VAT][0-9]+-[0-9]{3}$",
          "description": "片段稳定 id,确定性生成规则:<轨道 id>-<片段序号+1 三位零填>,如 V1-003;锚点(kind=clip)与 Op target 均引用它,禁止依赖数组下标"
        },
        "sourceHash": {
          "type": "string",
          "description": "可选:源文件内容寻址 hash;供缓存与'文件变了但时间没变'检测,语义与 artboard manifest 的 sourceHash 一致(计划书 3.3 第 6 项)"
        },
        "src": {
          "type": "string"
        },
        "startMs": {
          "type": "number",
          "minimum": 0
        },
        "durationMs": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sourceInMs": {
          "type": "number",
          "minimum": 0
        },
        "speed": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 4
        },
        "speedCurve": {
          "type": "array",
          "minItems": 1,
          "description": "分段速度曲线(册四 A4 T4.4):点集 {atMs, speed},atMs 为相对片段 startMs 的时间线毫秒;相邻点之间不内插——每段按其左点速度常速播放(曲线段恒速语义),如需平滑斜坡请加中间点。有 speedCurve 时渲染/投影以其为准,speed 字段仅作无曲线时的兼容回退;段界与总源消耗 = Σ Δt×speed(分段积分),内核 endMs 与渲染时长由此严格一致(对拍夹具锁定)",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "atMs",
              "speed"
            ],
            "properties": {
              "atMs": {
                "type": "number",
                "minimum": 0
              },
              "speed": {
                "type": "number",
                "minimum": 0.25,
                "maximum": 4
              }
            }
          }
        },
        "reverse": {
          "type": "boolean",
          "default": false,
          "description": "倒放(册四 A4 T4.4):视频 reverse 滤镜 / 音频 areverse;组合顺序 = reverse 先于变速(先倒回再变速)。内存警示:ffmpeg reverse 滤镜把整段读入内存缓冲,长片段(4K/长时序)可能耗尽内存——长素材请先切短再倒放,该约束在 parity 夹具与渲染链注释同步声明"
        },
        "rotation": {
          "type": "number",
          "description": "旋转角度(度;册四 A4 T4.9):任意值,渲染端按 mod 360 归一;±90 的整数倍走 transpose(无裁切精确互换宽高),其余角度 rotate 滤镜画布内旋转、出界部分裁切黑底补白,再经 scale/pad 适配画幅"
        },
        "crop": {
          "type": "object",
          "additionalProperties": false,
          "description": "源域裁剪(册四 A4 T4.9):矩形 {x,y,w,h},源素材像素坐标(非画幅坐标),在画幅归一(scale/pad)之前执行;与 flip/rotation 的叠加顺序 = 裁剪 → 翻转 → 旋转 → 画幅归一 → punchIn → reverse → 变速",
          "required": [
            "w",
            "h"
          ],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "w": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "h": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          }
        },
        "flip": {
          "enum": [
            "none",
            "h",
            "v"
          ],
          "description": "翻转(册四 A4 T4.9):h=水平镜像(hflip)、v=垂直镜像(vflip)、none=不翻转;作用于裁剪之后、旋转之前的源域"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "role": {
          "enum": [
            "voice",
            "sfx",
            "music",
            "ambient"
          ]
        },
        "text": {
          "type": "string"
        },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "scale": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 4
        },
        "reframe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "anchorY": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "in": {
              "enum": [
                "none",
                "fadeIn",
                "slideInLeft",
                "slideInRight",
                "slideInUp",
                "slideInDown",
                "scaleIn",
                "zoomIn",
                "popIn",
                "bounceIn",
                "spinIn"
              ],
              "description": "入场动画(册四 T4.6 扩充;只收真实渲染项,目录 = schemas/fx-catalog.json motion.in;既有 6 值语义逐字兼容且自本册起真实渲染)"
            },
            "inFx": {
              "type": "string",
              "description": "入场特效 fxId(CutFlow 分册04 §4.1 扩展);与 in 枚举并存,声明时优先于枚举。未注册渲染端降级并 WARN + fxDegraded 留痕"
            },
            "inMs": {
              "type": "number",
              "default": 400
            },
            "out": {
              "enum": [
                "none",
                "fadeOut",
                "slideOutLeft",
                "slideOutRight",
                "slideOutUp",
                "slideOutDown",
                "zoomOut",
                "popOut",
                "bounceOut",
                "spinOut"
              ],
              "description": "出场动画(册四 T4.6 扩充;时窗 = 末尾 outMs;目录 = schemas/fx-catalog.json motion.out)"
            },
            "outFx": {
              "type": "string",
              "description": "出场特效 fxId(CutFlow 分册04 §4.1 扩展);与 out 枚举并存,声明时优先于枚举。未注册渲染端降级并 WARN + fxDegraded 留痕"
            },
            "outMs": {
              "type": "number",
              "default": 400
            }
          }
        },
        "transition": {
          "type": "object",
          "additionalProperties": false,
          "description": "与前一片段的转场(xfade)。v0.10(ADR-0023):尾帧扩展保证零时间漂移;v0.11(ADR-0026)三级语法:reason=jumpcut(源间隙<1s 的同段跳切)→ 1 帧软切;reason=topic(≥1s 真切换)→ 按 durMs 溶解(默认 300);无 reason 的亚帧转场仍提升为 joinCrossfadeMs;type=cut/none 显式硬切。durMs 是唯一合法时长字段",
          "properties": {
            "type": {
              "enum": [
                "fade",
                "wipeleft",
                "wipeup",
                "slideleft",
                "circleopen",
                "cut",
                "none"
              ]
            },
            "durMs": {
              "type": "number",
              "default": 500
            },
            "fx": {
              "type": "string",
              "description": "转场 fxId 直通(册四 T4.5 目录化):tr.<id> 或裸 id,目录 = schemas/transition-catalog.json(ffmpeg xfade 全集 58 项实测);与 type 并存两者同给以 fx 为准并 WARN。未注册 fxId 回退 type(缺省 fade)并留痕 fxDegraded(compose 步进度事件 warnings 数组)"
            },
            "reason": {
              "enum": [
                "jumpcut",
                "topic"
              ],
              "description": "转场语法制(generated by rs_ir --from-cutlist)"
            }
          }
        },
        "overlay": {
          "type": "object",
          "additionalProperties": false,
          "description": "绝对像素落点(rs_brand 变体轨产出);存在时优先于 scale/position",
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0
            },
            "w": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "h": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 1
            }
          }
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "overlay 层整体不透明度(scale/position 路径也生效)"
        },
        "fade": {
          "type": "object",
          "additionalProperties": false,
          "description": "音频淡入淡出(毫秒);仅 5.9 草稿后端写入,FFmpeg 后端暂忽略",
          "properties": {
            "inMs": {
              "type": "number",
              "default": 0
            },
            "outMs": {
              "type": "number",
              "default": 0
            }
          }
        },
        "loop": {
          "type": "boolean",
          "default": false,
          "description": "视频素材循环播放(如 6s 无缝循环背景铺满整段时长)"
        },
        "punchIn": {
          "type": "object",
          "additionalProperties": false,
          "description": "v0.11 R3 punch-in:该段变焦取紧构图,掩饰 jump cut(Hitchcock:重点句才用)",
          "properties": {
            "factor": {
              "type": "number",
              "minimum": 1.0,
              "maximum": 2.0,
              "default": 1.4
            },
            "source": {
              "enum": [
                "auto",
                "manual"
              ]
            }
          }
        },
        "freezeMs": {
          "type": "number",
          "minimum": 1,
          "description": "v0.12(ADR-0027)冻结帧补长:源正常播放到该毫秒,其后 tpad 克隆尾帧补足到 durationMs(-t 在输入侧);纯动画卡片比旁白短时由 rs_ir build --from-cards 写入,冻结须在出场动画开始前(组装器预留 950ms)"
        },
        "assetId": {
          "type": "string",
          "description": "素材库 manifest.json 的稳定 id(CutFlow 分册01/ADR-0053);sfx.add --assetId / element.add / asset.swap 的引用锚;渲染仍由 src 驱动,本字段是溯源与换素材键"
        },
        "fx": {
          "type": "object",
          "additionalProperties": false,
          "description": "fx.apply 挂载的单片段特效(CutFlow 分册04 §4.2):slot(in|out|combo)→ {fx, params};未注册渲染端降级并 WARN + fxDegraded 留痕",
          "properties": {
            "in": {
              "$ref": "#/$defs/fxEntry"
            },
            "out": {
              "$ref": "#/$defs/fxEntry"
            },
            "combo": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/fxEntry"
              },
              "description": "整段特效叠加栈(册四 T4.6):上限 3 条,数组顺序即应用顺序;整组替换(clip_update patch.fx.combo 原子)。未注册 fxId 逐项降级 WARN,不整链回退"
            }
          }
        },
        "font": {
          "type": "object",
          "additionalProperties": false,
          "description": "片段级字体覆盖(font.set --scope clip;字体唯一真相源在 artboard fonts/,S7 字幕链消费)",
          "required": [
            "family"
          ],
          "properties": {
            "family": {
              "type": "string"
            }
          }
        },
        "huazi": {
          "type": "object",
          "additionalProperties": false,
          "description": "花字模板挂载(huazi.set / subtitle.set 扩展,CutFlow 分册04 §4.2/ADR-0057):S7 rs_subtitle --huazi 消费,经 ASS 富文本重建,渲染端零新增通道",
          "required": [
            "template"
          ],
          "properties": {
            "template": {
              "type": "string",
              "description": "花字模板 id(huazi.*;素材库 manifest.json kind=huazi)"
            },
            "params": {
              "type": "object",
              "description": "模板参数(透传 S7)"
            }
          }
        },
        "matte": {
          "type": "object",
