{
 "version": 2,
 "_doc": "MCP 工具契约(G5-1/M4-1 比对基准)。38 工具 = 13 查询 + 18 写 + 7 编排;stdio 与内嵌 HTTP 通道共用同一注册表(工具集差异恒为 0)。数量以本文件 tools 数组为准(B7 口径单一真相源;阶段二新增 clip_add/media_probe/media_browse/project_new 后 34→38)。outputSchema 统一引用 #/definitions/envelope(计划书 5.4 结果协议与错误码表)。",
 "channels": [
  "stdio",
  "embedded-http"
 ],
 "definitions": {
  "envelope": {
   "type": "object",
   "required": [
    "ok",
    "code",
    "message",
    "data"
   ],
   "properties": {
    "ok": {
     "type": "boolean"
    },
    "code": {
     "enum": [
      "OK",
      "CONFLICT",
      "SCHEMA_INVALID",
      "PRECONDITION_FAILED",
      "GUARD_FAILED",
      "JIANYING_RUNNING",
      "NO_CONFIG",
      "DEP_MISSING",
      "GREEN_SCREEN_INPUT",
      "INTERNAL"
     ]
    },
    "message": {
     "type": "string"
    },
    "data": {
     "type": "object"
    }
   }
  }
 },
